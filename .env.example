NODE_ENV="development"

# Host that uses the alternate header/footer chrome color.
BLUE_DGST_HOST=""

# Auth.js secret
AUTH_SECRET=""

# jwt secret
NEXTAUTH_SECRET=""

# Google client OAuth credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# kakao  client OAuth credentials
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# PostgreSQL (primary database)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dgstdb"
POSTGRES_PASSWORD=""

# Google reCaptcha credentials
PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=""
GOOGLE_RECAPTCHA_SECRET_KEY=""

# File upload staging directory (files are removed after MinIO upload)
UPLOAD_PATH=""
# MinIO object storage. MINIO_BUCKET may include an optional key prefix,
# for example "local/dgst".
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET=""
MINIO_REGION=""
# adapter-node global request body limit. Must be at least board upload limit.
BODY_SIZE_LIMIT="100M"

# logging (Grafana/Loki — stdout JSON 한 줄)
LOG_LEVEL="info"
LOG_FORMAT="json"
SERVICE_NAME="dgst"
LOG_DIR="./logs"

# Legacy Redis maintenance scripts only
# REDIS_URL="redis://localhost:6379"
